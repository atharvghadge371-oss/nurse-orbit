# Copy to frontend/.env and restart `npx expo start` after changing it.
#
# Base URL of the backend (without /api). Must be reachable from the phone/emulator,
# so use your computer's LAN IP rather than localhost, e.g. http://192.168.1.20:8001
#
# If left empty, development builds use port 8001 on the same machine as the Expo dev server.
EXPO_PUBLIC_BACKEND_URL=
