# Copy to backend/.env and fill in. Run with:
#   uvicorn server:app --host 0.0.0.0 --port 8001
# (--host 0.0.0.0 lets a phone / emulator on your network reach it)

# Required
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=nurseorbit
# Long random string, e.g. output of: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional
JWT_EXPIRE_MINUTES=10080
ADMIN_EMAIL=admin@nurseorbit.app
# Comma-separated list of allowed origins for the web build; * allows all
CORS_ORIGINS=*
MAX_UPLOAD_MB=25

# AI chat, image generation, TTS and file storage (documents, lab reports, book PDFs).
# Without this key those endpoints return 503; everything else works.
EMERGENT_LLM_KEY=
